#include <iostream>
using namespace std;
bool makina(int x);


int main() {

	int x, sonuc;

	cout << "Bir Sayi Giriniz :";
	cin >> x;
	sonuc = makina(x);

	if (sonuc == true) {
		cout << "Girilen Sayi Pozitif";
	}
	else
	{
		cout << "Girilen Sayi Negatif";
	}


	return 0;
}

bool makina(int x) {

	if (x > 0) {
		return true;
	}
	else
	{
		return false;
	}
}
